# No quotes around values. Escape literal $ as $$. Save as LF line endings, not CRLF.
# Timezone
TZ=Europe/Stockholm

# Basic auth for the WUD web UI.
WUD_ADMIN_USER=

# Apache-style APR1 (MD5) hash -- NOT bcrypt. Generate with:
#   htpasswd -nb 'yourusername' 'yourpassword' | cut -d: -f2
# If the hash itself contains $ characters (APR1 hashes always do),
# escape each one as $$ or Compose will silently corrupt the value.
WUD_ADMIN_PASSWORD_HASH=
