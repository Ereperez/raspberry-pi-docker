# No quotes around values. Escape literal $ as $$. Save as LF line endings, not CRLF.
# Timezone
TZ=Europe/Stockholm

# From healthchecks.io -- create a check, copy the UUID portion of its
# Ping URL (https://hc-ping.com/<UUID>), paste just the UUID here.
HEALTHCHECKS_UUID=

# WUD basic-auth header, base64 of "username:password" (the same
# credentials used for WUD's own login). Generate with:
#   echo -n 'yourusername:yourpassword' | base64
# The output can itself contain = or other characters -- check it doesn't
# need $ escaping (it won't unless your password does), but do check.
WUD_BASIC_AUTH_B64=

# Tailscale: a SEPARATE API access token from the one used in Homepage's
# .env (or the same one, copied over -- your call). Generate at
# https://login.tailscale.com/admin/settings/keys -> Generate API access
# token. Expires in max 90 days, independent of Homepage's copy and the
# container's own TS_AUTHKEY.
GATUS_TAILSCALE_API_KEY=
# Machines -> click rpi4-homelab -> Machine Details -> ID ending in CNTRL
GATUS_TAILSCALE_DEVICE_ID=
