# Timezone
TZ=Europe/Stockholm
# Comma-separated list of hostnames/IPs (with port) allowed to load Homepage.
# Example: 192.168.1.79:3000,homepage.local
HOMEPAGE_ALLOWED_HOSTS=192.168.1.79:3000,homepage.local
PUID=1000
PGID=1000
# GID of the "docker" group on the Pi -- find with: getent group docker
DOCKER_GID=
