# No quotes around values. Escape literal $ as $$. Save as LF line endings, not CRLF.
# Timezone
TZ=Europe/Stockholm
# Must include every host:port combination used to access Homepage
HOMEPAGE_ALLOWED_HOSTS=192.168.1.79:3000,homepage.local
PUID=1000
PGID=1000
# GID of the "docker" group on the Pi -- find with: getent group docker
DOCKER_GID=

# Homepage's own env-var substitution requires the HOMEPAGE_VAR_ prefix on
# the variable name itself, referenced in services.yaml as
# {{HOMEPAGE_VAR_X}} -- NOT Compose's ${X} syntax. See docs/homepage-dashboard.md.

# Pi-hole: Settings -> Web interface/API -> Expert mode -> Configure app password
HOMEPAGE_VAR_PIHOLE_API_KEY=

# Backrest: the login password set on first visit to the Backrest web UI
HOMEPAGE_VAR_BACKREST_PASSWORD=

# Portainer: API token for the scoped 'homepage' user (Standard role, with
# per-container Restricted ownership granted -- see docs/homepage-dashboard.md)
HOMEPAGE_VAR_PORTAINER_API_KEY=

# WUD: same username/password used for the WUD web UI login.
# NOTE: this is the PLAINTEXT password, not the APR1 hash stored in
# wud/.env as WUD_ADMIN_PASSWORD_HASH -- two different credentials for
# two different purposes.
HOMEPAGE_VAR_WUD_ADMIN_USER=
HOMEPAGE_VAR_WUD_ADMIN_PASSWORD=

# Beszel: same email/password used to log into the Beszel hub web UI
# (the account created on first visit -- this is the PocketBase
# "superuser" the Beszel widget requires).
HOMEPAGE_VAR_BESZEL_USERNAME=
HOMEPAGE_VAR_BESZEL_PASSWORD=

# Tailscale: NOT the container's TS_AUTHKEY -- a separate API access
# token, generated at https://login.tailscale.com/admin/settings/keys
# (Generate API access token, not an auth key). Also expires (max 90
# days) -- same recurring renewal as the container's own auth key.
# Device ID: Machines -> click rpi4-homelab -> Machine Details -> copy
# the ID ending in CNTRL.
HOMEPAGE_VAR_TAILSCALE_API_KEY=
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
